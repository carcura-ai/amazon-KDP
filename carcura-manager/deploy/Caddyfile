{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	reverse_proxy app:4800
	header -Server
	log {
		output stdout
		# Datensparsamkeit: keine Query-Strings (z. B. Einmal-Links zum Passwort-Reset), keine Cookies,
		# keine Zugangsdaten in Proxy-Logs
		format filter {
			wrap json
			fields {
				request>uri regexp [?].* ?[entfernt]
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Lead-Token delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
