# Kopie als deploy/.env anlegen und ausfüllen. Diese Datei NIE ins Git-Repository.
# Öffentliche Adresse (DNS-A-Eintrag auf die Server-IP zeigen lassen)
DOMAIN=app.carcura.info
# Geheimschlüssel für Sitzungen und verschlüsselte Zugangsdaten: 48+ zufällige Zeichen,
# z. B. erzeugen mit: openssl rand -base64 48   – separat sicher aufbewahren (ohne ihn sind
# gespeicherte API-Schlüssel nach einer Wiederherstellung nicht lesbar)
APP_SECRET=
# selfhosted = ein Betrieb, alle Module; saas = mehrere Mandanten mit Tarifen
DEPLOYMENT_MODE=selfhosted
# Anzahl Proxys vor der App (Caddy = 1)
TRUST_PROXY=1
LOG_LEVEL=info
# Mindestversion der Desktop-App (ältere Versionen erhalten einen Update-Hinweis)
MIN_DESKTOP_VERSION=1.0.0
# Betreiber-Postfach für Konto-E-Mails (Passwort vergessen). Ohne Angabe wird das SMTP des Mandanten genutzt.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_SMTP_FROM=
SYSTEM_SMTP_FROM_NAME=Carcura Management
