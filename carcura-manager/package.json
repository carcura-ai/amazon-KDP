{
  "name": "carcura-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Mandantenfähiges Management-System für Fahrzeugaufbereiter (erster Mandant: Carcura)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w server"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
