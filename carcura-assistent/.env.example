# ===== Carcura-Assistent – Einstellungen =====
# Kopieren nach .env und ausfüllen. Die Datei .env niemals weitergeben oder hochladen.

# Subdomain, unter der der Assistent erreichbar ist (DNS-A-Eintrag auf die Server-IP)
BOT_DOMAIN=bot.carcura.info

# Inhaber: Name:Handynummer, durch Komma getrennt (Format egal, wird umgerechnet)
OWNERS=Alex:+49 170 6669516,Richy:+49 1XX XXXXXXX

# --- WhatsApp Cloud API (Meta) ---
# dauerhafter Zugriffstoken (System-User im Meta Business Manager)
WA_TOKEN=
# Telefonnummer-ID der Assistenten-Nummer (nicht die Nummer selbst)
WA_PHONE_NUMBER_ID=
# App-Geheimschlüssel (App-Einstellungen → Allgemeines)
WA_APP_SECRET=
# frei ausgedachtes Passwort, gleiches bei Meta im Webhook eintragen
WA_VERIFY_TOKEN=
WA_TEMPLATE_NAME=carcura_hinweis
WA_TEMPLATE_LANG=de

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = günstiger und schneller, high = gründlicher
CLAUDE_EFFORT=medium
# bei Fehlalarm eines Sicherheitsfilters automatisch anderes Modell
CLAUDE_FALLBACKS=on

# --- Website-Anfragen ---
# langes Zufallspasswort, gleiches im WordPress-Plugin eintragen
LEAD_SECRET=

# --- WordPress (für Änderungen an der Website) ---
WP_URL=https://carcura.info
# WordPress-Benutzername
WP_USER=
# Anwendungspasswort (Profil → Anwendungspasswörter)
WP_APP_PASSWORD=

# --- E-Mail an Kunden (web.de) ---
SMTP_HOST=smtp.web.de
SMTP_PORT=587
SMTP_USER=carcura@web.de
# web.de-Passwort bzw. App-Passwort
SMTP_PASS=
MAIL_FROM=Carcura <carcura@web.de>
# Kopie jeder Kunden-Mail ins eigene Postfach
MAIL_BCC=carcura@web.de

# --- Sonstiges ---
TIMEZONE=Europe/Berlin
# Montags 9 Uhr Anfragen-Rückblick
WEEKLY_SUMMARY=on
WEATHER_PLACE=Walterschen
WEATHER_LAT=50.69
WEATHER_LON=7.58
