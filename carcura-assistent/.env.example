# ===== Carcura-Assistent – Einstellungen =====
# Kopieren nach .env und ausfüllen. Die Datei .env niemals weitergeben oder hochladen.

# Subdomain, unter der der Assistent erreichbar ist (DNS-A-Eintrag auf die Server-IP)
BOT_DOMAIN=bot.carcura.info

# Inhaber: Name:PRIVATE Handynummer, durch Komma getrennt (Format egal, wird umgerechnet)
# Nicht die Nummer, über die der Bot läuft!
OWNERS=Alex:+49 1XX XXXXXXX,Richy:+49 1XX XXXXXXX

# Nummer, über die der Bot läuft (zur Kontrolle)
WA_BOT_NUMBER=
# Was passiert, wenn Kunden an die Bot-Nummer schreiben:
#   hinweis = eigene Assistenten-Nummer: Kunde bekommt einmal am Tag den Verweis auf die Firmennummer
#   melden  = Bot läuft auf der Firmennummer (Koexistenz): Kunde bekommt NICHTS vom Bot, ihr werdet benachrichtigt
#   still   = nichts tun
KUNDEN_CHATS=hinweis

# --- WhatsApp Cloud API (Meta) ---
# dauerhafter Zugriffstoken (System-User im Meta Business Manager)
WA_TOKEN=
# Telefonnummer-ID der Assistenten-Nummer (nicht die Nummer selbst)
WA_PHONE_NUMBER_ID=
# App-Geheimschlüssel (App-Einstellungen → Allgemeines)
WA_APP_SECRET=
# frei ausgedachtes Passwort, gleiches bei Meta im Webhook eintragen
WA_VERIFY_TOKEN=
WA_TEMPLATE_NAME=carcura_hinweis
WA_TEMPLATE_LANG=de

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = günstiger und schneller, high = gründlicher
CLAUDE_EFFORT=medium
# bei Fehlalarm eines Sicherheitsfilters automatisch anderes Modell
CLAUDE_FALLBACKS=on

# --- Website-Anfragen ---
# langes Zufallspasswort, gleiches im WordPress-Plugin eintragen
LEAD_SECRET=

# --- WordPress (für Änderungen an der Website) ---
WP_URL=https://carcura.info
# WordPress-Benutzername
WP_USER=
# Anwendungspasswort (Profil → Anwendungspasswörter)
WP_APP_PASSWORD=

# --- E-Mail an Kunden (web.de) ---
SMTP_HOST=smtp.web.de
SMTP_PORT=587
SMTP_USER=carcura@web.de
# web.de-Passwort bzw. App-Passwort
SMTP_PASS=
MAIL_FROM=Carcura <carcura@web.de>
# Kopie jeder Kunden-Mail ins eigene Postfach
MAIL_BCC=carcura@web.de

# --- Zahlen & Bewertungen (Windsor.ai: Google Ads, Analytics, Unternehmensprofil) ---
# API-Schlüssel: windsor.ai → Einstellungen/API
WINDSOR_API_KEY=
WINDSOR_ADS_ACCOUNT=919-151-5213
WINDSOR_GA4_ACCOUNT=548650753
WINDSOR_GBP_LOCATION=locations/3129400474567791595
# optional, sobald Meta Ads in Windsor verbunden ist (Werbekonto-ID)
WINDSOR_META_ACCOUNT=
# neue Google-Bewertungen sofort melden (on/off)
BEWERTUNGEN_MELDEN=on
# automatisch antworten ab: 5 (nur 5 Sterne), 4 (4 und 5) oder aus
BEWERTUNG_AUTO_ANTWORT=5

# --- Antworten auf Bewertungen selbst posten (optional, Google Business Profile API) ---
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
# accounts/123… (im Unternehmensprofil-Manager bzw. per API ermittelbar)
GBP_ACCOUNT=

# --- Sonstiges ---
TIMEZONE=Europe/Berlin
# Montags 9 Uhr Anfragen-Rückblick
WEEKLY_SUMMARY=on
WEATHER_PLACE=Walterschen
WEATHER_LAT=50.69
WEATHER_LON=7.58
